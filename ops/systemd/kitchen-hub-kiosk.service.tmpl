[Unit]
Description=Chromium Kiosk for Kitchen Hub
After=graphical.target kitchen-hub.service
Wants=kitchen-hub.service

[Service]
User=%i
Environment=DISPLAY=:0
ExecStart=/usr/bin/chromium-browser --noerrdialogs --disable-translate --kiosk http://localhost:5000
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
