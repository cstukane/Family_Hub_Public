[Unit]
Description=Family Hub Main Application
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/family-hub
Environment=PATH=/opt/family-hub/.venv/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/family-hub/.venv/bin/python hub_app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target