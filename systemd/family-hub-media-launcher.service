[Unit]
Description=Family Hub Media Launcher
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/kitchen-hub
Environment=PATH=/opt/kitchen-hub/.venv/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kitchen-hub/.venv/bin/python media_launcher.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target