# Optional absolute path; defaults to instance/config.yaml when present
FAMILY_HUB_CONFIG=

# Core security
SECRET_KEY=
SOCKETIO_ALLOWED_ORIGINS=
RATELIMIT_STORAGE_URI=

# Admin bootstrap (required if security.admin_enabled is true)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Commute map providers
COMMUTE_GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=
COMMUTE_MAPBOX_TOKEN=
MAPBOX_TOKEN=

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sports provider
THESPORTSDB_API_KEY=
SPORTS_API_KEY=

# Runtime metadata
FLASK_ENV=production

# Logging
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_FILE=logs/family_hub.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s %(levelname)s [%(name)s] %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
