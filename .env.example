# Optional absolute path; defaults to instance/config.yaml when present
FAMILY_HUB_CONFIG=

# Core security
SECRET_KEY=
SOCKETIO_ALLOWED_ORIGINS=
RATELIMIT_STORAGE_URI=

# Admin bootstrap (required if security.admin_enabled is true)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Media launcher auth
MEDIA_LAUNCHER_JWT_SECRET=
MEDIA_LAUNCHER_TOKEN_TTL=300
MEDIA_LAUNCHER_ALLOW_LEGACY_AUTH=false
MEDIA_HUB_AUTH_TOKEN=

# Hub app auth (hub_app.py)
HUB_APP_AUTH_ENABLED=true

# Commute map providers
COMMUTE_GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=
COMMUTE_MAPBOX_TOKEN=
MAPBOX_TOKEN=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/integrations/spotify/callback

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sports provider
THESPORTSDB_API_KEY=
SPORTS_API_KEY=

# Google Photos
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
GOOGLE_PHOTOS_REFRESH_TOKEN=

# Webhooks
WEBHOOK_DEFAULT_SECRET=
WEBHOOK_DEFAULT_AUTHORIZATION=

# Alexa (discovery and commands)
ALEXA_ACCESS_TOKEN=
ALEXA_API_BASE_URL=https://api.amazonalexa.com
ALEXA_DEVICES_ENDPOINT=/v1/devices
ALEXA_LOG_PAYLOADS=false

# Runtime metadata
FLASK_ENV=production

# Logging
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_FILE=logs/family_hub.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s %(levelname)s [%(name)s] %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
